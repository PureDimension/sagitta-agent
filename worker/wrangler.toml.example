# Copy this file to worker/wrangler.toml locally, then replace every placeholder.
# Do not commit the local copy or real Cloudflare identifiers.
name = "REPLACE_WITH_SAGITTA_WORKER_SCRIPT_NAME"
main = "worker.js"
compatibility_date = "REPLACE_WITH_YYYY_MM_DD"
account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"

[[d1_databases]]
binding = "DB"
database_name = "REPLACE_WITH_D1_DATABASE_NAME"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"
