# Copy this file to .env.local. That file is ignored by Git.
# Without a key, the UI and chunk storage/search can run with provider=none.
# LLM extraction, observation consolidation, reflect and page generation
# require a configured LLM provider.
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
HINDSIGHT_API_REFLECT_LLM_TIMEOUT=120
