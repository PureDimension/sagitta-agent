{
  "name": "@sagitta/updater",
  "version": "0.1.0",
  "private": true,
  "description": "启动时更新 Sagitta，再注册其预设；Updater 自身手动安装。",
  "type": "module",
  "engines": { "dsh": "0.2.1-rc.2" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.6",
    "@types/js-yaml": "4.0.9"
  },
  "dependencies": { "js-yaml": "4.3.2" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.2"
  }
}
