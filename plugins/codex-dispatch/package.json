{
  "name": "@sagitta/codex-dispatch",
  "version": "0.2.0",
  "type": "module",
  "description": "Sagitta codex 派单适配器：受控 codex 子进程委托给通用 async-work 注册表",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.10"
  },
  "license": "UNLICENSED",
  "private": true,
  "peerDependencies": {
    "@sagitta/async-work": "^0.1.0",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@sagitta/async-work": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/process-tree.js && node --check test/smoke.mjs && node --check test/process-tree.mjs",
    "smoke": "node test/smoke.mjs && node test/process-tree.mjs"
  }
}
