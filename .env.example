# Copy this file to ~/.config/sagitta/memory.env on macmini and fill values
# through a private channel. Do not commit the filled file.
#
# CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET are bare Cloudflare Access
# service-token values. Do not include a header name or a Bearer prefix.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional Worker fallback token. Leave empty when Access Service Auth is used.
AUTH_TOKEN=

# Optional per-machine overrides. The installer writes proxy=direct in the DSH
# patch; set this only if macmini needs a local HTTP proxy.
DSH_MEMORY_PROXY=direct
# DSH_MEMORY_BASE_URL=https://your-worker.example
